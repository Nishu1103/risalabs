# Postgres connection string. On Supabase: Project → Connect → "Transaction pooler" (port 6543).
# Example: postgresql://postgres.abcd:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Google AI Studio key (free tier works): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Leave unset to use the code default: gemini-3.8-flash, then gemini-3-flash-preview, then gemini-3.1-flash-lite.
# gemini-2.5-flash and gemini-2.0-flash currently 404 for new keys ("no longer available").
# GEMINI_MODEL=gemini-3.8-flash

# Optional: protects POST /api/reset. Leave empty so reviewers can reset (the assignment demo).
RESET_TOKEN=

# Session-mode pooler. The app itself uses DATABASE_URL.
DIRECT_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
